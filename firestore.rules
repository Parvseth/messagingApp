rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Define the exact hardcoded Firebase Auth UIDs allowed in this 2-user hyper-private app
    // Replace "USER_A_UID" and "USER_B_UID" with your actual Firebase Auth UIDs
    // Allow any authenticated user for now since the real UIDs are unknown.
    // To lock this down later, replace this with: 
    // return request.auth != null && (request.auth.uid == "YOUR_REAL_UID_1" || request.auth.uid == "YOUR_REAL_UID_2");
    function isAuthorizedUser() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Pairs Collection
    match /pairs/{pairId} {
      // A user can read/create a pair if they are part of it
      allow read, create: if request.auth != null && (request.auth.uid in request.resource.data.participants || request.auth.uid in resource.data.participants);
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    // Encrypted Messages Collection
    match /messages/{messageId} {
      // READ: Allowed if authenticated
      allow read: if request.auth != null;

      // CREATE: Allowed ONLY if:
      // 1. Caller is an authorized participant
      // 2. The senderId matches the caller's Firebase Auth UID
      // 3. Payload strictly contains ciphertext and nonce
      // 4. Plaintext fields are strictly forbidden
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasAll(['ciphertext', 'nonce', 'senderId', 'pairId', 'createdAt', 'type', 'status'])
        && !request.resource.data.keys().hasAny(['text', 'message', 'plaintext', 'payload']);

      // UPDATE: Allow updating status (delivered, read)
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveredAt', 'readAt']);

      allow delete: if false;
    }
  }
}
